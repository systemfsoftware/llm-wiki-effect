#!/usr/bin/env sh
set -e
remote=origin

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ "$branch" != "main" ]; then
  exit 0
fi

if ! remote_main=$(git ls-remote --heads "$remote" main 2>/dev/null); then
  echo "pre-push: could not reach $remote to check main." >&2
  echo "Refusing to push main without verifying it is up to date." >&2
  exit 1
fi
main_sha=$(printf '%s\n' "$remote_main" | cut -f1)
if [ -z "$main_sha" ]; then
  exit 0
fi

if ! git cat-file -e "$main_sha^{commit}" 2>/dev/null; then
  git fetch --quiet "$remote" main || {
    echo "pre-push: could not fetch $remote main." >&2
    exit 1
  }
fi

if ! git merge-base --is-ancestor "$main_sha" HEAD; then
  echo "pre-push: main is behind $remote/main ($main_sha)." >&2
  echo "Rebase or merge $remote/main before pushing main." >&2
  exit 1
fi
