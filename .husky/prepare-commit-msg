#!/bin/sh
COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

case "$COMMIT_SOURCE" in
  merge|squash)
    exit 0
    ;;
esac

if [ -f "$COMMIT_MSG_FILE" ]; then
  temp_file=$(mktemp)
  grep -v -E -i "^Co-?-?[Aa]uthored-by:.*<.*(noreply@anthropic\.com|cursoragent@cursor\.com|noreply@aider\.dev|cascade@windsurf\.com|noreply@codeium\.com|clio-agent@sisyphuslabs\.ai|factory-droid\[bot\]@users\.noreply\.github\.com)>" "$COMMIT_MSG_FILE" > "$temp_file"
  if [ -s "$temp_file" ]; then
    mv "$temp_file" "$COMMIT_MSG_FILE"
  else
    rm "$temp_file"
    echo "prepare-commit-msg: the message was only AI co-author trailers, which this repo does not accept." >&2
    echo "Write a real subject line, for example 'fix(chat): keep the previews across a conversation switch'." >&2
    exit 1
  fi
fi
