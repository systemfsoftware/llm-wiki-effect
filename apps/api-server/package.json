{
  "name": "llm-wiki-api-server",
  "version": "0.1.0",
  "description": "Standalone Effect RPC server for LLM Wiki: the API as a deployable process, in worker and standalone modes",
  "type": "module",
  "scripts": {
    "lint": "oxlint . --type-aware --type-check",
    "build": "rolldown -c rolldown.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:mutation": "stryker run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@lancedb/lancedb": "0.27.2",
    "effect": "catalog:",
    "llm-wiki-protocol": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@types/node": "^20.0.0",
    "fast-check": "catalog:",
    "llm-wiki-oxlint-config": "workspace:*",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
