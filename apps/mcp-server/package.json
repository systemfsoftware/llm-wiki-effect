{
  "name": "llm-wiki-mcp-server",
  "version": "0.4.26",
  "description": "MCP server for LLM Wiki local API",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "llm-wiki-mcp": "dist/src/index.js"
  },
  "scripts": {
    "lint": "oxlint . --type-aware --type-check",
    "build": "rolldown -c rolldown.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "start": "node dist/src/index.js",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "llm-wiki",
    "knowledge-base"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@systemfsoftware/tsconfig": "catalog:",
    "@types/node": "^20.0.0",
    "llm-wiki-oxlint-config": "workspace:*",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:"
  }
}
