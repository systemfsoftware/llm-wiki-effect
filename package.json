{
  "name": "llm-wiki",
  "private": true,
  "version": "0.6.11",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --build --pretty",
    "build": "pnpm typecheck && vite build",
    "build:desktop": "pnpm mcp:build && pnpm build",
    "preview": "vite preview",
    "test": "pnpm test:mocks && pnpm test:llm",
    "test:mocks": "vitest run --exclude='**/*.real-llm.test.ts' --exclude='**/mcp-server/**'",
    "test:llm": "vitest run real-llm --no-file-parallelism --reporter=verbose",
    "mcp:build": "pnpm --filter llm-wiki-mcp-server build",
    "mcp:typecheck": "pnpm --filter llm-wiki-mcp-server typecheck",
    "mcp:test": "pnpm --filter llm-wiki-mcp-server test",
    "format": "./bin/dprint fmt",
    "format:check": "./bin/dprint check",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "version:sync": "node scripts/sync-app-version.mjs",
    "release:version": "changeset version && pnpm version:sync",
    "lint": "oxlint . --type-aware --type-check --format=${OXLINT_FORMAT:-default}",
    "precommit": "pnpm exec lint-staged --no-revert --config .lintstagedrc.js",
    "prepare": "husky",
    "gate:tasks": "pnpm format:check && pnpm lint && pnpm mcp:typecheck && pnpm test:mocks",
    "gate:dist": "pnpm build",
    "check:ci": "s=0; pnpm format:check || s=1; pnpm lint || s=1; pnpm build || s=1; pnpm test:mocks || s=1; pnpm mcp:test || s=1; exit $s",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@milkdown/kit": "^7.20.0",
    "@milkdown/plugin-math": "^7.5.9",
    "@milkdown/react": "^7.20.0",
    "@milkdown/theme-nord": "^7.20.0",
    "@react-sigma/core": "^5.0.6",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@types/js-yaml": "^4.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "i18next": "^26.0.3",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.45",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.14.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.9.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.1.2",
    "sigma": "^3.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^25.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dprint": "catalog:",
    "fast-check": "^4.7.0",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.0.0",
    "vitest": "^4.1.4"
  }
}
