{
  "name": "llm-wiki-effect",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter llm-wiki dev",
    "build": "turbo run build",
    "build:desktop": "turbo run typecheck build",
    "tauri": "pnpm --filter llm-wiki tauri",
    "test": "pnpm test:mocks && pnpm test:llm",
    "test:mocks": "turbo run test:mocks",
    "test:llm": "pnpm --filter llm-wiki test:llm",
    "mcp:build": "turbo run build --filter=llm-wiki-mcp-server",
    "mcp:typecheck": "turbo run typecheck --filter=llm-wiki-mcp-server",
    "mcp:test": "turbo run test --filter=llm-wiki-mcp-server",
    "api:build": "turbo run build --filter=llm-wiki-api-server",
    "api:test": "turbo run test --filter=llm-wiki-api-server",
    "format": "node bin/dprint.mjs fmt",
    "format:check": "node bin/dprint.mjs check",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "version:sync": "node scripts/sync-app-version.mjs",
    "release:version": "changeset version && pnpm version:sync",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "precommit": "pnpm exec lint-staged --no-revert --config .lintstagedrc.js",
    "prepare": "husky",
    "gate:tasks": "pnpm --filter llm-wiki-protocol build && turbo run --continue --concurrency=100% lint typecheck llm-wiki#test:mocks llm-wiki-mcp-server#test llm-wiki-protocol#test llm-wiki-api-server#test",
    "gate:dist": "turbo run --concurrency=100% --continue build",
    "check:ci": "node scripts/check-ci.mjs format:check gate:tasks gate:dist"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@types/node": "^25.5.2",
    "dprint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "llm-wiki-oxlint-config": "workspace:*",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
