{
  "$schema": "https://v2-10-1.turborepo.dev/schema.json",
  "globalEnv": ["CI", "NODE_ENV"],
  "globalPassThroughEnv": ["XDG_CACHE_HOME", "GITHUB_ACTIONS", "AGENT"],
  "tasks": {
    "lint": {
      "outputLogs": "errors-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "oxlint.config.ts",
        "tsconfig*.json",
        "$TURBO_ROOT$/packages/oxlint-config/src/**",
        "$TURBO_ROOT$/packages/oxlint-config/package.json",
        "!**/*.md",
        "!**/repos/**"
      ],
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "outputLogs": "errors-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig*.json",
        "$TURBO_ROOT$/packages/oxlint-config/src/**",
        "!**/*.md",
        "!**/repos/**",
        "!src-tauri/**"
      ],
      "outputs": [],
      "cache": true
    },
    "build": {
      "outputLogs": "new-only",
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/repos/**", "!src-tauri/**"],
      "outputs": ["dist/**"],
      "dependsOn": ["typecheck"],
      "cache": true
    },
    "test:mocks": {
      "outputLogs": "errors-only",
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/repos/**"],
      "outputs": [],
      "cache": true
    },
    "test": {
      "outputLogs": "errors-only",
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["dist-test/**"],
      "dependsOn": ["build"],
      "cache": true
    }
  }
}
